# Postgres connection string for the pmocockpit database.
DATABASE_URL=postgresql://user:password@localhost:5435/pmocockpit

# Single passphrase required to log in to the app (any non-empty string).
APP_PASSCODE=replace-with-your-passcode

# Random hex string (32+ chars) used to HMAC-sign session cookies.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-random-hex
